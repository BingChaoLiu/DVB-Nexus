{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dvb-sandbox/observation/event-envelope-1.0.schema.json",
  "title": "DVB Sandbox Canonical Event Envelope v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "producer",
    "scope",
    "time",
    "severity",
    "payload",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "producer_version",
        "instance_id"
      ],
      "properties": {
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "producer_version": {
          "type": "string"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "producer_seq": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "session_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "scenario_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "observed"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/timepoint"
        },
        "observed": {
          "$ref": "#/$defs/timepoint"
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "span_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "fault_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 8191
        }
      }
    },
    "severity": {
      "enum": [
        "debug",
        "info",
        "notice",
        "warning",
        "error",
        "critical"
      ]
    },
    "payload": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    }
  },
  "$defs": {
    "timepoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_ns",
        "clock_domain",
        "clock_epoch"
      ],
      "properties": {
        "value_ns": {
          "type": "integer"
        },
        "clock_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "clock_epoch": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
