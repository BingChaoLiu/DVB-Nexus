{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dvb-sandbox/observation/event-envelope-1.0.schema.json",
  "$comment": "多 schema 文档版本策略（SPEC-301 §8 / ADR-0006 第 4 条）：本文档描述且仅描述 schema_version 1.0（const）。minor 演进 = 新增新 $id 的 schema 文档（additive optional only）；major 才是破坏性变更。信封松、负载紧：payload 由 per-event-type schema 独立版本化并严格校验，本信封只要求其为 object。",
  "title": "DVB Sandbox Canonical Event Envelope v1.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "producer",
    "scope",
    "time",
    "severity",
    "payload",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "$comment": "uuid4 opaque（ADR-0006 第 3 条，ULID 废弃）；重试稳定，去重键 (producer_id, event_id) 之一半"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "producer_id",
        "producer_version",
        "instance_id"
      ],
      "properties": {
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "producer_version": {
          "type": "string"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "producer_seq": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "$comment": "生产者内部序，optional（ADR-0006 第 2 条：MVP 可不填；非全序凭据）"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tenant_id",
        "session_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "$comment": "MVP 恒为 local（ADR-0006 第 1 条）"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "$comment": "nullable 仅限 system-level 事件"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "$comment": "Run 是八步闭环（ADR-0002）的事件归属单位；session 级事件为 null（ADR-0006 第 1 条嫁接项）"
        },
        "scenario_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "observed"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/timepoint"
        },
        "observed": {
          "$ref": "#/$defs/timepoint"
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "span_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "fault_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "拓扑内语义 slug（ADR-0006 第 3 条）；node_id 单独 = 节点级寻址，node_id+pid = 流级"
        },
        "port_id": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "端口级寻址（ADR-0005 决策 5 多端口 Mux；ADR-0006 第 3 条）"
        },
        "service_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 8191
        }
      }
    },
    "journal_seq": {
      "type": "integer",
      "minimum": 0,
      "$comment": "唯一全序凭据（int64，per session 单调）；gateway durable append 时盖章，生产者永不填（ADR-0006 第 2 条）。发布视图中缺省，落库记录视图中存在"
    },
    "severity": {
      "enum": [
        "debug",
        "info",
        "notice",
        "warning",
        "error",
        "critical"
      ]
    },
    "payload": {
      "type": "object",
      "$comment": "负载紧：per-event-type payload schema 独立版本化并严格校验（SPEC-301 §7/§8），本层不放宽也不定义业务字段（如 confidence 属 payload 层）"
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    }
  },
  "$defs": {
    "timepoint": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "value_ns",
        "clock_domain",
        "clock_epoch"
      ],
      "properties": {
        "value_ns": {
          "type": "integer",
          "$comment": "有符号 64 位整数纳秒"
        },
        "clock_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "$comment": "如 sim:<session_id> 或 wall:utc"
        },
        "clock_epoch": {
          "type": "integer",
          "minimum": 0,
          "$comment": "生产者时钟重启时递增（SPEC-300 §6 规则 5）"
        }
      },
      "$comment": "信封 timepoint 不设 semantics 字段——source/observed 字段名即语义（SPEC-301 §6）；独立记录的 timepoint 须显式 semantics（SPEC-300 §6）"
    }
  }
}
