{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dvb-sandbox/observation/metric-sample-1.0.schema.json",
  "$comment": "指标样本（SPEC-302 §3）：timepoint 显式语义；revision/is_final 承载迟到样本重聚合语义（SPEC-302 §6.2）。",
  "title": "Observation Metric Sample",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "metric_name",
    "value_type",
    "value",
    "time",
    "dimensions",
    "quality",
    "provenance"
  ],
  "properties": {
    "metric_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "value_type": {
      "enum": [
        "counter",
        "gauge",
        "histogram"
      ]
    },
    "value": {
      "type": [
        "number",
        "object",
        "null"
      ],
      "$comment": "缺口默认不补零：null + quality missing（SPEC-302 §6.3）"
    },
    "unit": {
      "type": "string"
    },
    "time": {
      "type": "object",
      "required": [
        "value_ns",
        "clock_domain",
        "clock_epoch",
        "semantics"
      ],
      "properties": {
        "value_ns": {
          "type": "integer"
        },
        "clock_domain": {
          "type": "string"
        },
        "clock_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "semantics": {
          "enum": [
            "source",
            "observed",
            "derived"
          ],
          "$comment": "独立记录 timepoint 显式语义（SPEC-300 §6；[缝合批准 #12] Q6 裁决）"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean"
        ]
      },
      "$comment": "仅允许 SPEC-302 §5 维度白名单内的键（strict 默认拒绝未知维度）；session 域指标必含 session_id 维度"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "$comment": "回填重聚合必须递增（SPEC-302 §6.2；[缝合批准 #12] Q6 裁决）"
    },
    "is_final": {
      "type": "boolean",
      "default": true,
      "$comment": "回填修订期间为 false，直至重新定稿（SPEC-302 §6.2）"
    },
    "quality": {
      "type": "array",
      "items": {
        "enum": [
          "good",
          "missing",
          "late",
          "estimated",
          "partial",
          "revised",
          "invalid"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_event_ids"
      ],
      "properties": {
        "source_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journal_watermark": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "$comment": "每个聚合值可解释（来源事件 ID 或派生水位）"
    }
  }
}
