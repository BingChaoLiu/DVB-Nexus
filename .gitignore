# Machine-local tooling: .claude/skills holds absolute-path symlinks generated
# by the skills setup; re-created per machine, never shared.
.claude/

# Local scratch
.scratch/

# Python virtualenv (local dev tooling, never shared)
.venv/

# Python build/import artifacts
__pycache__/
*.egg-info/
.pytest_cache/

# Frontend (frontend/ engineering scaffold, ticket #61 — node_modules never
# enters git; every worktree installs fresh, SPEC-400 §9)
frontend/node_modules/
