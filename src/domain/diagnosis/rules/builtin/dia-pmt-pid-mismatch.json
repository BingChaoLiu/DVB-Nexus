{
  "rule_id": "DIA-PMT-PID-MISMATCH",
  "rule_version": "1.0.0",
  "code": "DIAG_PMT_PID_MISMATCH",
  "priority": 40,
  "severity": "error",
  "confidence": "medium",
  "title": "PAT points at a PMT PID with no PMT",
  "summary_template": "PAT declares program_map_pid {actual_program_map_pid} but the PMT sits on {expected_program_map_pid} (orphan PMT) at packet {packet_index}; artefact {artifact_id}",
  "match": {
    "event_type": "ts.psi_section_observed",
    "predicates": [
      {
        "field": "payload.section",
        "op": "eq",
        "value": "PAT"
      },
      {
        "field": "payload.expected_program_map_pid",
        "op": "exists",
        "value": null
      },
      {
        "field": "payload.actual_program_map_pid",
        "op": "exists",
        "value": null
      }
    ],
    "group_by": [
      "node_id",
      "pid"
    ],
    "window": null
  },
  "suppression": {
    "key": [
      "code",
      "node_id"
    ],
    "window": "per_run"
  },
  "suggested_actions": [
    "Correct the PAT program_map_pid entry"
  ],
  "expected_evidence": [
    "ts.psi_section_observed"
  ],
  "enabled": true
}
